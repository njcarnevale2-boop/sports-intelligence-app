# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.env
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python backend
backend/.venv/
backend/**/__pycache__/
*.pyc
.pytest_cache/
backend/.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime/local databases
sports_intelligence.db
backend/*.db
backend/*.sqlite
backend/*.sqlite3
backend/*.sqlite-journal
backend/*_test.db
backend/*_mock.db

# Research outputs (generated)
backend/research_outputs/*
!backend/research_outputs/sia_corrected_historical_baseline_report.md
!backend/research_outputs/sia_corrected_historical_baseline_report.json

# Logs and temp
*.log
backend/logs/
tmp/
backend/tmp/

# Render seed staging artifacts (local-only, large binary data)
deployment/render_seed/payload/
deployment/render_seed/*.tar
deployment/render_seed/*.tar.gz
deployment/render_seed/*.tgz
deployment/render_seed/tmp/
