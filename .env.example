# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend
NFL_ANALYTICS_OS_ROOT=~/Downloads/NFL_Analytics_OS_v1_9
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./sports_intelligence.db
JWT_SECRET_KEY=dev-secret-key
ADMIN_API_KEY=dev-admin-token

# Providers
SPORTSRADAR_API_KEY=
WEATHER_API_KEY=
ODDS_API_KEY=

# Scheduler / automation
ODDS_REFRESH_AUTOMATION_ENABLED=false
PREGAME_AUTOMATION_ENABLED=false
PREGAME_MAX_REQUESTS_PER_RUN=25
PREGAME_MAX_ESTIMATED_CREDITS_PER_RUN=25
PREGAME_DAILY_ESTIMATED_CREDIT_BUDGET=
ODDS_WEEKLY_SOFT_BUDGET=700
ODDS_WEEKLY_HARD_BUDGET=1100
ODDS_MINIMUM_RESERVE=12000
ODDS_WARNING_THRESHOLD_REMAINING=15000
ODDS_PAUSE_THRESHOLD_REMAINING=12000

# Runtime
NODE_ENV=development
